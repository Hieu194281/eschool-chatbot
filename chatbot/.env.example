# ─────────────────────────────────────────────────────────────
# Tuyển Sinh Concierge — environment template (copy to .env, fill real values)
# .env is gitignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Channel (Messenger) ──────────────────────────────────────
PAGE_ACCESS_TOKEN=your-page-access-token
APP_SECRET=your-app-secret
VERIFY_TOKEN=choose-a-random-verify-token
MESSENGER_API_VERSION=v21.0

# ── Gemini ───────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key
# Verify these model IDs resolve at setup (see Phase 01 probe):
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── Google Sheet KB + leads ──────────────────────────────────
GOOGLE_SA_JSON_PATH=./secrets/service-account.json
KB_SHEET_ID=your-kb-sheet-id
LEADS_SHEET_ID=your-leads-sheet-id
KB_SYNC_INTERVAL_SEC=300

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_DSN=postgresql://tuyensinh:tuyensinh@localhost:5432/tuyensinh

# ── Telegram (tư-vấn-viên group + resume webhook) ────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-group-chat-id
TELEGRAM_WEBHOOK_SECRET=choose-a-random-webhook-secret

# ── Rate limit / spend caps (Phase 04) ───────────────────────
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=200
MAX_CONCURRENT_INVOKES=20
GEMINI_DAILY_BUDGET=10000

# ── PII retention (Phase 05, PDPD Decree 13/2023) ────────────
PII_RETENTION_DAYS=180

# ── App behavior ─────────────────────────────────────────────
DEBOUNCE_SECONDS=6
SHADOW_MODE=true
HANDOFF_AUTO_RESUME_HOURS=24
LOG_LEVEL=INFO

# ── LangGraph checkpoint deserialization hardening (Phase 03) ─
LANGGRAPH_STRICT_MSGPACK=true
